rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Validation Helper
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'totalScore', 'gamesPlayed', 'highestScore']) &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 50 &&
             data.totalScore is number && data.totalScore >= 0 &&
             data.gamesPlayed is number && data.gamesPlayed >= 0 &&
             data.highestScore is number && data.highestScore >= 0 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 100)) &&
             (!('ageGroup' in data) || (data.ageGroup is string && data.ageGroup.size() <= 20)) &&
             (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 30)) &&
             (!('millionWins' in data) || (data.millionWins is number && data.millionWins >= 0)) &&
             (!('level' in data) || (data.level is string && data.level.size() <= 50)) &&
             (!('unlockedAchievements' in data) || (data.unlockedAchievements is list && data.unlockedAchievements.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    // Score Validation Helper
    function isValidScore(data) {
      return data.keys().hasAll(['userId', 'displayName', 'score', 'category']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.score is number && data.score >= 0 &&
             data.category is string && data.category.size() <= 30 &&
             (!('avatarId' in data) || (data.avatarId is string && data.avatarId.size() <= 30)) &&
             (!('questionsAnswered' in data) || (data.questionsAnswered is number && data.questionsAnswered >= 0)) &&
             (!('wonMillion' in data) || data.wonMillion is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    // User Profile Match Block
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection: users cannot be listed in bulk
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'displayName', 'email', 'ageGroup', 'avatarId', 'totalScore',
                      'gamesPlayed', 'millionWins', 'highestScore', 'level',
                      'unlockedAchievements', 'updatedAt'
                    ]);
      allow delete: if false;
    }

    // Global Leaderboard Scores Match Block
    match /scores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(scoreId) &&
                    isValidScore(incoming()) &&
                    incoming().userId == request.auth.uid;
      allow update: if false; // Scores are immutable
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Connection Health Test Doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
